# Copy to .env.local (local) or set in Vercel Project Settings.
# Never commit real values. All NEXT_PUBLIC_* values are visible in the browser.
# Vercel's VERCEL / VERCEL_ENV / VERCEL_TARGET_ENV system variables must be
# exposed by Vercel itself and must never be created manually.

# --- Site ---------------------------------------------------------------
# REQUIRED in Vercel Production and Preview. Always use the public production
# origin here, never a *.vercel.app preview URL, so canonicals stay stable.
# Do not add a trailing slash.
NEXT_PUBLIC_SITE_URL=https://lademeter-rechner.de

# Optional: Google Search Console HTML-tag verification token (content value only).
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=

# --- Consent management (required before ANY Google service is loaded) -----
# Google Analytics and AdSense are NEVER loaded without a configured CMP.
# Provider: "google" (Google "Datenschutz & Mitteilungen", configured inside the
# AdSense account), "usercentrics" or "cookiebot". Use a CMP that is on Google's
# list of certified CMPs: https://support.google.com/adsense/answer/13554116
NEXT_PUBLIC_CMP_PROVIDER=
# Usercentrics: settings ID. Cookiebot: domain group ID (cbid). Not needed for "google".
NEXT_PUBLIC_CMP_ID=
# Cookiebot only: TCF framework value (see Cookiebot docs), default TCFv2.2.
NEXT_PUBLIC_COOKIEBOT_FRAMEWORK=

# --- Analytics (optional, consent-controlled) ----------------------------
# GA4 measurement ID (G-XXXXXXXXXX). Leave empty to keep analytics off.
NEXT_PUBLIC_GA_ID=
# Retention configured in GA4 (2 or 14) - shown in the privacy policy.
NEXT_PUBLIC_GA_RETENTION_MONTHS=

# --- AdSense (stays inactive until approval) -------------------------------
# Publisher ID from your AdSense account (ca-pub-0000000000000000). Setting only
# this adds the verification meta tag and enables ads.txt; no ads are shown.
NEXT_PUBLIC_ADSENSE_CLIENT=
# "true" activates ads: requires a valid client ID AND a configured CMP.
NEXT_PUBLIC_ADSENSE_ENABLED=false
# Numeric ad unit IDs (data-ad-slot) per placement. Placements without an ID stay empty.
NEXT_PUBLIC_ADSENSE_SLOT_SECTION=
NEXT_PUBLIC_ADSENSE_SLOT_ARTICLE_INTRO=
NEXT_PUBLIC_ADSENSE_SLOT_ARTICLE_END=

# --- Contact form (server-side, NOT public) --------------------------------
# Without all three, the form tells visitors honestly that it is unavailable.
# Delivery uses the Resend HTTP API (https://resend.com). The sender must be a
# domain verified at Resend.
RESEND_API_KEY=
CONTACT_TO_EMAIL=
CONTACT_FROM_EMAIL=
