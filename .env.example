# Copy to .env.local (local) or set in Vercel Project Settings.
# Never commit real values. All NEXT_PUBLIC_* values are visible in the browser.
# Vercel's VERCEL / VERCEL_ENV / VERCEL_TARGET_ENV system variables must be
# exposed by Vercel itself and must never be created manually.

# --- Site ---------------------------------------------------------------
# REQUIRED in Vercel Production and Preview. Always use the public production
# origin here, never a *.vercel.app preview URL, so canonicals stay stable.
# Do not add a trailing slash.
NEXT_PUBLIC_SITE_URL=https://lademeter-rechner.de

# Optional: Google Search Console HTML-tag verification token (content value only).
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=

# --- AdSense (OFF by default; apply for AdSense after launch) ---------------
# Step 1 (while applying): only the publisher ID (ca-pub-0000000000000000). This
# adds the verification meta tag and serves /ads.txt; no script, no ads.
NEXT_PUBLIC_ADSENSE_CLIENT=
# Step 2 (after approval AND after publishing Google's "Datenschutz & Mitteilungen"
# message in the AdSense account): "true" loads the AdSense script and shows ads.
NEXT_PUBLIC_ADSENSE_ENABLED=false
# Numeric ad unit IDs (data-ad-slot) per placement. Placements without an ID stay empty.
NEXT_PUBLIC_ADSENSE_SLOT_SECTION=
NEXT_PUBLIC_ADSENSE_SLOT_ARTICLE_END=

# --- Contact form (server-side, NOT public) --------------------------------
# Without the key, the form tells visitors honestly that it is unavailable.
# Delivery uses the Resend HTTP API (https://resend.com). Messages go to the
# operator e-mail in lib/legal/operator.ts; create the key in the Resend account
# registered with that address (mkashifshah10@gmail.com).
RESEND_API_KEY=

# --- Reichweitenmessung (cookiefrei, optional) ---
# NEXT_PUBLIC_PLAUSIBLE_DOMAIN=lademeter-rechner.de
# NEXT_PUBLIC_PLAUSIBLE_SRC=https://plausible.io/js/script.js

# --- Suchmaschinen-Verifizierung (optional, nur der content-Wert des Meta-Tags) ---
# NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
# NEXT_PUBLIC_BING_SITE_VERIFICATION=
